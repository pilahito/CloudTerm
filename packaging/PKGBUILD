# PKGBUILD para CloudTerm
#
# Instalación en todo el sistema (necesita sudo). Si prefieres no tocar el
# sistema, usa `scripts/instalar.sh`, que lo deja todo en ~/.local.
#
# Uso:
#   cd packaging
#   makepkg -si
#
# Si el repositorio aún no está publicado, crea antes el tarball desde el árbol
# local:
#   tar --exclude=node_modules --exclude=target --exclude=dist \
#       --transform 's,^,cloudterm-0.1.0/,' -czf cloudterm-0.1.0.tar.gz -C .. .

pkgname=cloudterm
pkgver=1.0.4
pkgrel=1
pkgdesc="Cliente SSH/SFTP de escritorio con panel de transferencias y Pixel Agents"
arch=('x86_64' 'aarch64')
url="https://github.com/pilahito/cloudterm"
license=('AGPL-3.0-or-later')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libsoup3'
  'openssl'
  'hicolor-icon-theme'
)
makedepends=(
  'rust'
  'cargo'
  'nodejs'
  'npm'
  'imagemagick'
)
provides=('cloudterm')
conflicts=('cloudterm-bin' 'cloudterm-git')

# Se compila desde el árbol local empaquetado como tarball. Cuando el
# repositorio esté publicado, cambia esta línea por:
#   source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')  # se calculará al publicar

build() {
  cd "$pkgname-$pkgver"

  # `npm ci` necesita el package-lock.json, que va en el tarball.
  npm ci

  # Solo el binario: los paquetes .deb/.rpm/.AppImage no sirven en Arch.
  npm run tauri build -- --no-bundle
}

package() {
  cd "$pkgname-$pkgver"

  # Binario
  install -Dm755 src-tauri/target/release/cloudterm "$pkgdir/usr/bin/cloudterm"

  # Iconos en los tamaños que pide el tema hicolor
  for tamano in 32 64 128 256 512; do
    install -d "$pkgdir/usr/share/icons/hicolor/${tamano}x${tamano}/apps"
    magick docs/brand/icon-1024.png -resize "${tamano}x${tamano}" \
      "$pkgdir/usr/share/icons/hicolor/${tamano}x${tamano}/apps/cloudterm.png"
  done
  install -Dm644 docs/brand/icon.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/cloudterm.svg"

  # Entrada de escritorio (usa la ruta del sistema, no la del usuario)
  install -Dm644 packaging/cloudterm.desktop \
    "$pkgdir/usr/share/applications/cloudterm.desktop"

  # Licencia
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Documentación
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
