{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudTerm",
  "version": "1.0.9",
  "identifier": "com.pilahito.cloudterm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CloudTerm",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": true,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --disable-background-timer-throttling --enable-gpu-rasterization"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["cloudterm"],
          "host": "callback"
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "pilahito",
    "homepage": "https://github.com/pilahito/cloudterm",
    "shortDescription": "Cliente SSH y SFTP de escritorio con soporte de Pixel Agents",
    "longDescription": "CloudTerm es un cliente SSH y SFTP de escritorio: terminal remota, transferencia de archivos, Pixel Agents y un asistente IA.",
    "copyright": "© pilahito — GNU AGPL-3.0-or-later",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "section": "net",
        "priority": "optional",
        "desktopTemplate": "../packaging/linux/cloudterm.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "languages": ["Spanish", "English", "SimpChinese"],
        "displayLanguageSelector": true,
        "installerIcon": "../packaging/installer/icon.ico",
        "uninstallerIcon": "../packaging/installer/icon.ico",
        "headerImage": "../packaging/installer/installer-header.bmp",
        "sidebarImage": "../packaging/installer/installer-sidebar.bmp",
        "installerHooks": "../packaging/nsis/hooks.nsh",
        "customLanguageFiles": {
          "English": "../packaging/nsis/English.nsh",
          "Spanish": "../packaging/nsis/Spanish.nsh",
          "SimpChinese": "../packaging/nsis/SimpChinese.nsh"
        },
        "compression": "lzma"
      }
    }
  }
}
