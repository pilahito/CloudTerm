{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudTerm",
  "version": "1.0.0",
  "identifier": "com.pilahito.cloudterm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CloudTerm",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Terminal SSH/SFTP con asistente IA",
    "longDescription": "CloudTerm es un cliente de terminal SSH/SFTP de escritorio con transferencia de archivos, gestión de credenciales en el llavero del sistema y un asistente IA integrado.",
    "copyright": "© pilahito — GNU AGPL-3.0-or-later",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "Spanish",
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  }
}
